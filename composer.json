{
    "name": "vendor/laravel-invoice",
    "description": "A complete, professional, and production-ready invoice engine for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "your.email@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Vendor\\LaravelInvoice\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\LaravelInvoice\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\LaravelInvoice\\InvoiceServiceProvider"
            ],
            "aliases": {
                "Invoice": "Vendor\\LaravelInvoice\\Facades\\Invoice"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
